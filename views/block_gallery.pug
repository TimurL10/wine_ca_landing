style.
  .cool-gallery {
    position: relative;
    overflow: hidden;
    padding: clamp(64px, 9vw, 112px) 0;
    color: #14222b;
    background:
      radial-gradient(ellipse at 12% 18%, rgba(118, 199, 232, .34), transparent 32%),
      radial-gradient(ellipse at 90% 84%, rgba(204, 224, 233, .56), transparent 34%),
      linear-gradient(135deg, #eef6f8 0%, #dce8ed 48%, #f8fbfb 100%);
    font-family: var(--kv-main, Manrope, Arial, sans-serif);
    isolation: isolate;
  }

  .cool-gallery__grain {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: .12;
    background-image:
      linear-gradient(rgba(20, 34, 43, .13) 1px, transparent 1px),
      linear-gradient(90deg, rgba(20, 34, 43, .11) 1px, transparent 1px);
    background-size: 42px 42px;
    pointer-events: none;
  }

  .cool-gallery__watermark {
    position: absolute;
    top: 22px;
    left: 3%;
    z-index: 0;
    color: rgba(20, 34, 43, .055);
    font-size: clamp(4.2rem, 13vw, 12rem);
    font-weight: 900;
    line-height: .82;
    text-transform: uppercase;
    pointer-events: none;
  }

  .cool-gallery__container {
    position: relative;
    z-index: 1;
    width: min(calc(100% - 44px), 1120px);
    margin-inline: auto;
  }

  .cool-gallery__header {
    display: grid;
    grid-template-columns: minmax(150px, .24fr) minmax(0, .82fr) minmax(260px, .44fr);
    gap: clamp(18px, 3vw, 34px);
    align-items: end;
    margin-bottom: clamp(28px, 5vw, 54px);
  }

  .cool-gallery__label {
    display: flex;
    min-height: 140px;
    flex-direction: column;
    justify-content: space-between;
    padding: 20px;
    border: 1px solid rgba(20, 34, 43, .13);
    background: rgba(255, 255, 255, .38);
    backdrop-filter: blur(12px);
    font-size: .72rem;
    font-weight: 900;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .cool-gallery__label span {
    color: #5fb5d8;
    font-size: clamp(2.7rem, 5.6vw, 5rem);
    line-height: .82;
  }

  .cool-gallery__title {
    margin: 0;
    color: #14222b;
    font-size: clamp(3rem, 7vw, 7rem);
    font-weight: 900;
    line-height: .82;
    text-transform: uppercase;
  }

  .cool-gallery__title span {
    color: #5fb5d8;
  }

  .cool-gallery__lead {
    margin: 0;
    padding-top: 22px;
    border-top: 1px solid rgba(20, 34, 43, .18);
    color: rgba(20, 34, 43, .72);
    font-size: .9rem;
    font-weight: 800;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .cool-gallery__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: 158px;
    gap: 12px;
  }

  .cool-gallery__tile {
    position: relative;
    overflow: hidden;
    min-height: 0;
    border: 1px solid rgba(20, 34, 43, .12);
    background:
      linear-gradient(135deg, rgba(255, 255, 255, .7), rgba(255, 255, 255, .26)),
      rgba(222, 236, 242, .66);
    box-shadow: 0 22px 48px rgba(20, 34, 43, .08);
  }

  .cool-gallery__tile::before {
    position: absolute;
    inset: 14px;
    content: "";
    border: 1px solid rgba(255, 255, 255, .72);
    pointer-events: none;
  }

  .cool-gallery__tile::after {
    position: absolute;
    right: -44px;
    bottom: -52px;
    width: 128px;
    height: 128px;
    content: "";
    border-radius: 50%;
    background: rgba(95, 181, 216, .24);
    pointer-events: none;
  }

  .cool-gallery__tile--large {
    grid-column: span 2;
    grid-row: span 2;
  }

  .cool-gallery__tile--wide {
    grid-column: span 2;
  }

  .cool-gallery__tile--blue {
    background:
      linear-gradient(135deg, rgba(255, 255, 255, .58), rgba(255, 255, 255, .18)),
      rgba(118, 199, 232, .5);
  }

  .cool-gallery__tile--dark {
    background: #14222b;
    color: #eef6f8;
  }

  .cool-gallery__tile-number {
    position: absolute;
    left: 20px;
    top: 18px;
    color: currentColor;
    font-size: .74rem;
    font-weight: 900;
    letter-spacing: .1em;
    line-height: 1;
  }

  .cool-gallery__tile-line {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 18px;
    height: 1px;
    background: currentColor;
    opacity: .2;
  }

  .cool-gallery__tile-line::after {
    position: absolute;
    right: 0;
    top: -3px;
    width: 7px;
    height: 7px;
    content: "";
    border-radius: 50%;
    background: currentColor;
  }

  @media (max-width: 991.98px) {
    .cool-gallery__header {
      grid-template-columns: 1fr;
    }

    .cool-gallery__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 150px;
    }
  }

  @media (max-width: 575.98px) {
    .cool-gallery {
      padding: 48px 0 64px;
    }

    .cool-gallery__container {
      width: min(calc(100% - 34px), 1120px);
    }

    .cool-gallery__title {
      font-size: clamp(2.6rem, 14vw, 4.3rem);
    }

    .cool-gallery__grid {
      grid-template-columns: 1fr;
      grid-auto-rows: 180px;
    }

    .cool-gallery__tile--large,
    .cool-gallery__tile--wide {
      grid-column: span 1;
      grid-row: span 1;
    }
  }

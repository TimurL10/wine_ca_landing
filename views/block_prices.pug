section#prices.wine-prices
  span.wine-prices__grain
  span.wine-prices__decor PACKAGES
  span.wine-prices__decor-side PRICE / MUSIC PARTY
  span.wine-prices__shape.wine-prices__shape--blue
  span.wine-prices__shape.wine-prices__shape--orange

  .wine-prices__container
    .wine-prices__intro
      .wine-prices__headline
        span.wine-prices__eyebrow 04 / Пакетные предложения

        h2.wine-prices__title
          | Три сценария
          br
          span музыкальной вечеринки

      .wine-prices__summary
        .wine-prices__summary-item
          span 2-160
          p участников

        .wine-prices__summary-item
          span место проведения
          p ваш офис / выездная площадка

    .wine-prices__board
      .wine-prices__board-head
        span Пакеты
        span от 9 900 ₽
        span за человека

      .wine-prices__cards
        article.wine-prices__card.wine-prices__card--silver
          .wine-prices__label
            span.wine-prices__tier Silver
            span.wine-prices__price 9 900 ₽
            span.wine-prices__person за человека

          ul.wine-prices__list
            li Ведущий
            li Диджей
            li Музыкальная программа и артисты

          button.wine-prices__button(
            type="button"
            data-price-modal-open
            data-package="Silver"
          ) Посмотреть программу

        article.wine-prices__card.wine-prices__card--gold
          span.wine-prices__tag Оптимальный

          .wine-prices__label
            span.wine-prices__tier Gold
            span.wine-prices__price 10 900 ₽
            span.wine-prices__person за человека

          ul.wine-prices__list
            li Ведущий
            li Диджей
            li Музыкальная программа и артисты
            li Еда, напитки
            li Площадка

          button.wine-prices__button(
            type="button"
            data-price-modal-open
            data-package="Gold"
          ) Посмотреть программу

        article.wine-prices__card.wine-prices__card--platinum
          .wine-prices__label
            span.wine-prices__tier Platinum
            span.wine-prices__price 11 900 ₽
            span.wine-prices__person за человека

          ul.wine-prices__list
            li Ведущий
            li Диджей
            li Музыкальная программа и артисты
            li Еда, напитки
            li Площадка
            li Фотограф
            li Видеоограф

          button.wine-prices__button(
            type="button"
            data-price-modal-open
            data-package="Platinum"
          ) Посмотреть программу

  .wine-prices-modal(
    data-price-modal
    aria-hidden="true"
  )
    .wine-prices-modal__dialog(
      role="dialog"
      aria-modal="true"
      aria-labelledby="price-modal-title"
    )
      button.wine-prices-modal__close(
        type="button"
        aria-label="Закрыть программу"
        data-price-modal-close
      ) ×

      span.wine-prices-modal__eyebrow(data-price-modal-package) Пакет

      h3#wine-prices-modal-title.wine-prices-modal__title Программа вечера

      .wine-prices-modal__program(data-price-modal-program)

style.
  .wine-prices {
    position: relative;
    overflow: hidden;
    padding: clamp(54px, 8vw, 98px) 0;
    color: #181818;
    background:
      radial-gradient(ellipse at 16% 16%, rgba(118, 199, 232, .5), transparent 30%),
      radial-gradient(ellipse at 90% 76%, rgba(247, 203, 220, .46), transparent 32%),
      linear-gradient(135deg, #d8d9d5 0%, #b7b8b4 48%, #d1cfca 100%);
    font-family: var(--kv-main, Manrope, Arial, sans-serif);
    isolation: isolate;
  }

  .wine-prices__grain {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: .34;
    background-image:
      linear-gradient(rgba(255, 255, 255, .2) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 0, 0, .08) 1px, transparent 1px),
      repeating-radial-gradient(
        circle at 20% 26%,
        rgba(15, 15, 15, .32) 0,
        rgba(15, 15, 15, .32) .7px,
        transparent .8px,
        transparent 4px
      );
    background-size: 34px 34px, 34px 34px, 4px 4px;
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  .wine-prices__decor {
    position: absolute;
    top: 18px;
    left: 3%;
    z-index: 0;
    color: rgba(118, 199, 232, .58);
    font-size: clamp(4.2rem, 11vw, 10rem);
    font-weight: 900;
    line-height: .9;
    text-transform: uppercase;
    white-space: nowrap;
    pointer-events: none;
  }

  .wine-prices__decor-side {
    position: absolute;
    right: 22px;
    bottom: 94px;
    z-index: 1;
    color: rgba(24, 24, 24, .58);
    font-size: .76rem;
    font-weight: 900;
    letter-spacing: .2em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    pointer-events: none;
  }

  .wine-prices__shape {
    position: absolute;
    z-index: 0;
    pointer-events: none;
  }

  .wine-prices__shape--blue {
    right: 7%;
    top: 72px;
    width: clamp(120px, 18vw, 230px);
    height: clamp(120px, 18vw, 230px);
    border-radius: 50%;
    background: #76c7e8;
    transform: rotate(12deg);
  }

  .wine-prices__shape--orange {
    left: -70px;
    bottom: 76px;
    width: clamp(160px, 23vw, 290px);
    height: clamp(70px, 10vw, 128px);
    border-radius: 50%;
    background: #ed683a;
    transform: rotate(-18deg);
  }

  .wine-prices__container {
    position: relative;
    z-index: 1;
    width: min(calc(100% - 44px), 1120px);
    margin-inline: auto;
  }

  .wine-prices__intro {
    display: grid;
    align-items: end;
    grid-template-columns: minmax(0, 1fr) minmax(250px, .42fr);
    gap: 18px;
    margin-bottom: 18px;
  }

  .wine-prices__headline {
    padding: clamp(26px, 4vw, 44px);
    background: rgba(255, 250, 244, .88);
    box-shadow: 0 24px 56px rgba(24, 24, 24, .14);
  }

  .wine-prices__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 13px;
    color: #181818;
    font-size: .7rem;
    font-weight: 900;
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .wine-prices__eyebrow::before {
    width: 40px;
    height: 6px;
    border-radius: 999px;
    content: "";
    background: #76c7e8;
  }

  .wine-prices__title {
    margin: 0;
    color: #181818;
    font-size: clamp(2.9rem, 6.7vw, 6.4rem);
    font-weight: 900;
    line-height: .82;
    text-transform: uppercase;
  }

  .wine-prices__title span {
    color: #76c7e8;
    text-shadow: 0 2px 0 rgba(237, 104, 58, .2);
  }

  .wine-prices__summary {
    display: grid;
    gap: 10px;
  }

  .wine-prices__summary-item {
    min-height: 128px;
    padding: 18px;
    background: #181818;
    color: #fffaf4;
    box-shadow: 0 22px 44px rgba(24, 24, 24, .16);
  }

  .wine-prices__summary-item:last-child {
    color: #181818;
    background: #76c7e8;
  }

  .wine-prices__summary-item span {
    display: block;
    margin-bottom: 12px;
    font-size: clamp(1.55rem, 3vw, 2.5rem);
    font-weight: 900;
    line-height: .9;
    text-transform: uppercase;
  }

  .wine-prices__summary-item p {
    margin: 0;
    font-size: .76rem;
    font-weight: 900;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .wine-prices__board {
    position: relative;
    overflow: hidden;
    padding: clamp(14px, 2.6vw, 26px);
    background:
      radial-gradient(ellipse at 12% 24%, rgba(118, 199, 232, .84), transparent 26%),
      radial-gradient(ellipse at 96% 78%, rgba(237, 104, 58, .72), transparent 24%),
      linear-gradient(180deg, rgba(255, 250, 244, .84), rgba(255, 250, 244, .72));
    box-shadow: 0 30px 68px rgba(24, 24, 24, .16);
  }

  .wine-prices__board::after {
    position: absolute;
    right: 20%;
    bottom: -96px;
    width: 230px;
    height: 360px;
    content: "";
    border-radius: 50%;
    background: #f7cbdc;
    transform: rotate(24deg);
    pointer-events: none;
  }

  .wine-prices__board-head {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 10px;
    margin-bottom: 10px;
    color: #181818;
    font-size: .72rem;
    font-weight: 900;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .wine-prices__board-head span {
    padding: 10px 14px;
    border: 1px solid #181818;
    border-radius: 999px;
    background: rgba(255, 250, 244, .74);
  }

  .wine-prices__cards {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    align-items: stretch;
  }

  .wine-prices__card {
    position: relative;
    display: flex;
    min-height: 440px;
    overflow: hidden;
    flex-direction: column;
    padding: 24px;
    background: #fffaf4;
    box-shadow: 0 20px 40px rgba(24, 24, 24, .14);
    transition:
      transform .22s ease,
      box-shadow .22s ease;
  }

  .wine-prices__card::after {
    position: absolute;
    right: -46px;
    bottom: -42px;
    width: 136px;
    height: 136px;
    content: "";
    border-radius: 50%;
    background: #76c7e8;
  }

  .wine-prices__card--silver {
    margin-top: 34px;
  }

  .wine-prices__card--gold {
    min-height: 482px;
    background: #181818;
    color: #fffaf4;
  }

  .wine-prices__card--gold::after {
    background: #ed683a;
  }

  .wine-prices__card--platinum {
    margin-top: 18px;
  }

  .wine-prices__card--platinum::after {
    background: #f7cbdc;
  }

  .wine-prices__card:hover {
    transform: translateY(-7px) rotate(-.35deg);
    box-shadow: 0 30px 54px rgba(24, 24, 24, .2);
  }

  .wine-prices__tag {
    position: absolute;
    top: 18px;
    right: 18px;
    z-index: 1;
    padding: 7px 12px;
    border-radius: 999px;
    background: #76c7e8;
    color: #181818;
    font-size: .62rem;
    font-weight: 900;
    letter-spacing: .05em;
    text-transform: uppercase;
  }

  .wine-prices__label {
    position: relative;
    z-index: 1;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(24, 24, 24, .18);
  }

  .wine-prices__card--gold .wine-prices__label {
    border-bottom-color: rgba(255, 250, 244, .24);
  }

  .wine-prices__tier {
    display: block;
    max-width: 72%;
    color: inherit;
    font-size: clamp(2.2rem, 4vw, 3.7rem);
    font-weight: 900;
    line-height: .82;
    text-transform: uppercase;
  }

  .wine-prices__price {
    display: block;
    margin-top: 18px;
    color: #ed683a;
    font-size: 1.7rem;
    font-weight: 900;
    line-height: 1;
  }

  .wine-prices__card--gold .wine-prices__price {
    color: #76c7e8;
  }

  .wine-prices__person {
    display: block;
    margin-top: 6px;
    color: rgba(24, 24, 24, .62);
    font-size: .7rem;
    font-weight: 900;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .wine-prices__card--gold .wine-prices__person {
    color: rgba(255, 250, 244, .66);
  }

  .wine-prices__list {
    position: relative;
    z-index: 1;
    margin: 18px 0 26px;
    padding: 0;
    list-style: none;
    color: inherit;
    font-size: .84rem;
    font-weight: 800;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .wine-prices__list li {
    position: relative;
    padding: 10px 0 10px 24px;
    border-bottom: 1px solid rgba(24, 24, 24, .12);
  }

  .wine-prices__card--gold .wine-prices__list li {
    border-bottom-color: rgba(255, 250, 244, .16);
  }

  .wine-prices__list li::before {
    position: absolute;
    top: 14px;
    left: 0;
    width: 11px;
    height: 11px;
    content: "";
    border: 2px solid #76c7e8;
    border-radius: 50%;
    background: #fffaf4;
  }

  .wine-prices__card--gold .wine-prices__list li::before {
    background: #181818;
  }

  .wine-prices__button {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 44px;
    margin-top: auto;
    padding: 10px 16px;
    border: 1px solid #181818;
    border-radius: 999px;
    background: rgba(255, 250, 244, .82);
    color: #181818;
    font-family: inherit;
    font-size: .72rem;
    font-weight: 900;
    letter-spacing: .05em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background-color .2s ease,
      border-color .2s ease,
      color .2s ease,
      transform .2s ease;
  }

  .wine-prices__card--gold .wine-prices__button {
    border-color: #76c7e8;
    background: #76c7e8;
  }

  .wine-prices__button:hover {
    border-color: #ed683a;
    background: #ed683a;
    color: #fffaf4;
    transform: translateY(-2px);
  }

  .wine-prices-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    padding: 22px;
    background: rgba(24, 24, 24, .72);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    backdrop-filter: blur(5px) grayscale(1);
    transition:
      opacity .22s ease,
      visibility .22s ease;
  }

  .wine-prices-modal.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .wine-prices-modal__dialog {
    position: relative;
    width: min(100%, 560px);
    max-height: min(88vh, 760px);
    overflow: auto;
    padding: 34px 32px 30px;
    background:
      radial-gradient(ellipse at 96% 12%, rgba(118, 199, 232, .86), transparent 25%),
      linear-gradient(180deg, #fffaf4, #f0eee8);
    box-shadow: 0 34px 84px rgba(0, 0, 0, .34);
    transform: translateY(14px) scale(.98);
    transition: transform .22s ease;
  }

  .wine-prices-modal.is-open .wine-prices-modal__dialog {
    transform: translateY(0) scale(1);
  }

  .wine-prices-modal__close {
    position: absolute;
    top: 14px;
    right: 14px;
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border: 1px solid rgba(24, 24, 24, .18);
    border-radius: 50%;
    background: #76c7e8;
    color: #181818;
    font-family: inherit;
    font-size: 1.8rem;
    line-height: 1;
    cursor: pointer;
  }

  .wine-prices-modal__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
    color: #181818;
    font-size: .72rem;
    font-weight: 900;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .wine-prices-modal__eyebrow::before {
    width: 36px;
    height: 6px;
    border-radius: 999px;
    content: "";
    background: #ed683a;
  }

  .wine-prices-modal__title {
    margin: 0 0 18px;
    color: #181818;
    font-size: clamp(2.1rem, 6vw, 3.4rem);
    font-weight: 900;
    line-height: .86;
    text-transform: uppercase;
  }

  .wine-prices-modal__program {
    color: #242424;
    font-size: .92rem;
    font-weight: 800;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .wine-prices-modal__program p {
    margin: 0 0 12px;
    padding: 0 0 12px;
    border-bottom: 1px solid rgba(24, 24, 24, .12);
  }

  .wine-prices-modal__program strong {
    color: #ed683a;
    font-weight: 900;
  }

  @media (max-width: 991.98px) {
    .wine-prices__intro {
      grid-template-columns: 1fr;
    }

    .wine-prices__summary {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .wine-prices__cards {
      grid-template-columns: 1fr;
    }

    .wine-prices__card,
    .wine-prices__card--gold,
    .wine-prices__card--platinum {
      min-height: auto;
      margin-top: 0;
    }

    .wine-prices__decor-side {
      right: 10px;
      font-size: .68rem;
      letter-spacing: .16em;
    }
  }

  @media (max-width: 575.98px) {
    .wine-prices {
      padding: 42px 0 56px;
    }

    .wine-prices__container {
      width: min(calc(100% - 34px), 1120px);
    }

    .wine-prices__title {
      font-size: clamp(2.6rem, 14vw, 4.1rem);
    }

    .wine-prices__summary {
      grid-template-columns: 1fr;
    }

    .wine-prices__board-head {
      grid-template-columns: 1fr;
    }

    .wine-prices__card {
      padding: 22px 20px;
    }

    .wine-prices__decor {
      top: 20px;
      font-size: 4rem;
    }

    .wine-prices__decor-side {
      display: none;
    }

    .wine-prices-modal__dialog {
      padding: 30px 22px 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wine-prices__card,
    .wine-prices__button,
    .wine-prices-modal,
    .wine-prices-modal__dialog {
      transition: none;
    }
  }


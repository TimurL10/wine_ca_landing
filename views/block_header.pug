style.
  .hero-apartment {
    position: relative;
    min-height: 760px;
    overflow: hidden;
    isolation: isolate;
    color: #181818;
    background:
      radial-gradient(ellipse at 12% 82%, rgba(237, 104, 58, .34), transparent 28%),
      linear-gradient(135deg, #c8c8c4 0%, #a9aaa6 52%, #d4d2cd 100%);
    font-family: var(--kv-main, Manrope, Arial, sans-serif);
  }

  .hero-apartment__bg {
    position: absolute;
    inset: 0;
    z-index: -3;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: .78;
    filter: saturate(.96) contrast(1.05);
  }

  .hero-apartment::before,
  .hero-apartment__noise {
    position: absolute;
    inset: 0;
    z-index: -1;
    content: "";
    pointer-events: none;
  }

  .hero-apartment::before {
    background:
      linear-gradient(90deg, rgba(255, 250, 244, .72) 0%, rgba(255, 250, 244, .34) 42%, rgba(255, 250, 244, .04) 72%),
      radial-gradient(ellipse at 77% 18%, rgba(247, 203, 220, .52), transparent 32%),
      radial-gradient(ellipse at 86% 70%, rgba(237, 104, 58, .38), transparent 24%);
  }

  .hero-apartment__noise {
    opacity: .38;
    background-image:
      linear-gradient(rgba(255, 255, 255, .18) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 0, 0, .08) 1px, transparent 1px),
      repeating-radial-gradient(
        circle at 24% 28%,
        rgba(15, 15, 15, .32) 0,
        rgba(15, 15, 15, .32) .7px,
        transparent .8px,
        transparent 4px
      );
    background-size: 34px 34px, 34px 34px, 4px 4px;
    mix-blend-mode: multiply;
  }

  .hero-apartment__label {
    position: absolute;
    z-index: 2;
    color: rgba(24, 24, 24, .64);
    font-size: .72rem;
    font-weight: 900;
    letter-spacing: .18em;
    text-transform: uppercase;
    pointer-events: none;
  }

  .hero-apartment__label--top {
    top: 34px;
    left: 50%;
    transform: translateX(-50%);
  }

  .hero-apartment__label--side {
    right: 24px;
    top: 180px;
    writing-mode: vertical-rl;
  }

  .hero-apartment__flower {
    position: absolute;
    z-index: 1;
    pointer-events: none;
  }

  .hero-apartment__flower::before,
  .hero-apartment__flower::after {
    position: absolute;
    inset: 0;
    content: "";
    border-radius: 50%;
    background: currentColor;
  }

  .hero-apartment__flower--pink {
    right: clamp(20px, 8vw, 118px);
    bottom: 92px;
    width: clamp(120px, 18vw, 230px);
    height: clamp(54px, 8vw, 96px);
    color: #f7cbdc;
    transform: rotate(15deg);
  }

  .hero-apartment__flower--pink::before {
    transform: rotate(62deg);
  }

  .hero-apartment__flower--pink::after {
    transform: rotate(-62deg);
  }

  .hero-apartment__flower--orange {
    left: -62px;
    bottom: 112px;
    width: clamp(150px, 18vw, 250px);
    height: clamp(64px, 8vw, 102px);
    color: #ed683a;
    transform: rotate(-18deg);
  }

  .hero-apartment__flower--orange::before {
    transform: rotate(58deg);
  }

  .hero-apartment__flower--orange::after {
    transform: rotate(-58deg);
  }

  .hero-apartment__logo {
    position: absolute;
    top: 28px;
    left: clamp(18px, 4vw, 54px);
    z-index: 3;
    display: inline-block;
    color: #181818;
    font-family: var(--kv-main, Manrope, Arial, sans-serif);
    line-height: .8;
    text-decoration: none;
  }

  .hero-apartment__logo-main {
    display: block;
    font-size: clamp(.92rem, 2vw, 1.8rem);
    font-weight: 900;
    letter-spacing: 0;
  }

  .hero-apartment__logo-year {
    display: block;
    margin-top: 4px;
    margin-left: 58%;
    color: #ed683a;
    font-size: clamp(.28rem, .56vw, .46rem);
    font-weight: 900;
    letter-spacing: .06em;
    white-space: nowrap;
  }

  .hero-apartment__contacts {
    position: absolute;
    top: 24px;
    right: clamp(18px, 4vw, 54px);
    z-index: 4;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 7px;
    max-width: min(52vw, 620px);
  }

  .hero-apartment__contact {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 8px 12px;
    border: 1px solid rgba(24, 24, 24, .24);
    border-radius: 999px;
    background: rgba(255, 250, 244, .78);
    color: #181818;
    font-size: .68rem;
    font-weight: 900;
    letter-spacing: .03em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    backdrop-filter: blur(10px);
    transition:
      background-color .2s ease,
      border-color .2s ease,
      color .2s ease,
      transform .2s ease;
  }

  .hero-apartment__contact--phone {
    border-color: #ed683a;
    background: #ed683a;
    color: #fffaf4;
  }

  .hero-apartment__contact--telegram {
    justify-content: center;
    width: 38px;
    padding: 8px;
    color: #181818;
  }

  .hero-apartment__contact--telegram svg {
    width: 17px;
    height: 17px;
    fill: currentColor;
  }

  .hero-apartment__contact:hover {
    border-color: #181818;
    background: #181818;
    color: #fffaf4;
    transform: translateY(-2px);
  }

  .hero-apartment__toast {
    position: fixed;
    right: 22px;
    bottom: 22px;
    z-index: 1000;
    max-width: calc(100% - 44px);
    padding: 12px 16px;
    border: 1px solid rgba(24, 24, 24, .22);
    border-radius: 999px;
    background: #181818;
    color: #fffaf4;
    font-size: .76rem;
    font-weight: 900;
    letter-spacing: .04em;
    line-height: 1.2;
    text-transform: uppercase;
    box-shadow: 0 18px 44px rgba(24, 24, 24, .28);
    opacity: 0;
    pointer-events: none;
    transform: translateY(12px);
    transition:
      opacity .2s ease,
      transform .2s ease;
  }

  .hero-apartment__toast.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .hero-apartment__inner {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    min-height: 675px;
    max-width: 1120px;
  }

  .hero-apartment__content {
    width: min(100%, 760px);
    padding-top: 74px;
  }

  .hero-apartment__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
    color: #181818;
    font-size: .72rem;
    font-weight: 900;
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .hero-apartment__eyebrow::before {
    width: 42px;
    height: 6px;
    border-radius: 999px;
    content: "";
    background: #ed683a;
  }

  .hero-apartment__title {
    margin: 0;
    color: #f7cbdc;
    font-size: clamp(4rem, 9vw, 9.2rem);
    font-weight: 900;
    line-height: .8;
    letter-spacing: 0;
    text-transform: uppercase;
    text-shadow:
      0 2px 0 rgba(255, 250, 244, .62),
      0 16px 36px rgba(24, 24, 24, .16);
  }

  .hero-apartment__title span {
    color: #fffaf4;
  }

  .hero-apartment__subtitle {
    display: inline-flex;
    margin: 20px 0 18px;
    padding: 9px 18px;
    color: #fffaf4;
    border-radius: 999px;
    background: #ed683a;
    font-size: clamp(1rem, 2vw, 1.4rem);
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
    transform: rotate(-3deg);
  }

  .hero-apartment__description {
    max-width: 560px;
    margin: 0;
    color: #181818;
    font-size: clamp(.98rem, 1.45vw, 1.16rem);
    font-weight: 800;
    line-height: 1.42;
    text-transform: uppercase;
  }

  .hero-apartment__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }

  .hero-apartment__fact {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 8px 14px;
    border: 1px solid #181818;
    border-radius: 999px;
    background: rgba(255, 250, 244, .76);
    color: #181818;
    font-size: .7rem;
    font-weight: 900;
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .hero-apartment__fact:last-child {
    color: #fffaf4;
    border-color: #ed683a;
    background: #ed683a;
  }

  .hero-apartment__menu {
    position: relative;
    z-index: 3;
    padding: 0 0 24px;
  }

  .hero-apartment__menu-inner {
    display: flex;
    max-width: 1120px;
    flex-wrap: wrap;
    gap: 8px;
  }

  .hero-apartment__link {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: 9px 18px;
    border: 1px solid #181818;
    border-radius: 999px;
    background: rgba(255, 250, 244, .82);
    color: #181818;
    font-size: .75rem;
    font-weight: 900;
    letter-spacing: .04em;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background-color .2s ease,
      border-color .2s ease,
      color .2s ease,
      transform .2s ease;
  }

  .hero-apartment__link:hover,
  .hero-apartment__link--active {
    border-color: #ed683a;
    background: #ed683a;
    color: #fffaf4;
    transform: translateY(-2px);
  }

  @media (max-width: 991.98px) {
    .hero-apartment {
      min-height: auto;
    }

    .hero-apartment::before {
      background:
        linear-gradient(90deg, rgba(255, 250, 244, .82) 0%, rgba(255, 250, 244, .48) 62%, rgba(255, 250, 244, .1) 100%),
        radial-gradient(ellipse at 82% 20%, rgba(247, 203, 220, .52), transparent 34%);
    }

    .hero-apartment__inner {
      min-height: 640px;
      padding-top: 56px;
      padding-bottom: 42px;
    }

    .hero-apartment__content {
      padding-top: 58px;
    }

    .hero-apartment__contacts {
      top: 74px;
      left: clamp(18px, 4vw, 54px);
      right: auto;
      justify-content: flex-start;
      max-width: calc(100% - 36px);
    }
  }

  @media (max-width: 575.98px) {
    .hero-apartment__logo {
      top: 18px;
    }

    .hero-apartment__label--top,
    .hero-apartment__label--side {
      display: none;
    }

    .hero-apartment__contacts {
      top: 64px;
      gap: 6px;
    }

    .hero-apartment__contact {
      min-height: 31px;
      padding: 7px 10px;
      font-size: .6rem;
    }

    .hero-apartment__toast {
      right: 17px;
      bottom: 17px;
      font-size: .66rem;
    }

    .hero-apartment__inner {
      min-height: 570px;
      padding-top: 96px;
    }

    .hero-apartment__content {
      padding-top: 40px;
    }

    .hero-apartment__title {
      font-size: clamp(3.25rem, 17vw, 5.6rem);
    }

    .hero-apartment__description {
      max-width: 94%;
      font-size: .88rem;
    }

    .hero-apartment__flower--orange {
      left: -84px;
      bottom: 118px;
    }

    .hero-apartment__flower--pink {
      right: -32px;
      bottom: 72px;
    }

    .hero-apartment__menu {
      padding-bottom: 16px;
    }

    .hero-apartment__link {
      min-height: 38px;
      padding: 8px 12px;
      font-size: .66rem;
    }
  }

script.
  (() => {
    const phoneLink = document.querySelector('[data-copy-phone]');
    const mailLink = document.querySelector('[data-mail-link]');
    const toast = document.querySelector('.hero-apartment__toast');
    let toastTimer;

    const showToast = () => {
      if (!toast) return;
      clearTimeout(toastTimer);
      toast.classList.add('is-visible');
      toastTimer = setTimeout(() => {
        toast.classList.remove('is-visible');
      }, 2200);
    };

    const copyText = async (text) => {
      if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(text);
        return;
      }

      const input = document.createElement('input');
      input.value = text;
      input.setAttribute('readonly', '');
      input.style.position = 'fixed';
      input.style.left = '-9999px';
      document.body.appendChild(input);
      input.select();
      document.execCommand('copy');
      input.remove();
    };

    phoneLink?.addEventListener('click', async (event) => {
      event.preventDefault();
      try {
        await copyText(phoneLink.dataset.copyPhone || phoneLink.textContent.trim());
        showToast();
      } catch (error) {
        window.location.href = phoneLink.href;
      }
    });

    mailLink?.addEventListener('click', (event) => {
      event.preventDefault();
      window.open(mailLink.href, '_blank', 'noopener');
    });
  })();

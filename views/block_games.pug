section#games.games-block
  span.games-block__grain
  span.games-block__poster-word PLAY
  span.games-block__side-label LIVE / GAMES / TEAM
  span.games-block__shape.games-block__shape--pink
  span.games-block__shape.games-block__shape--lime
  span.games-block__shape.games-block__shape--blue

  .games-block__container
    .games-block__top
      .games-block__kicker
        span 05
        | Игры и активности

      h2.games-block__title
        | Разогреваем
        br
        span зал

      .games-block__note
        p Выберите механику под характер команды: музыкальный драйв, интеллектуальный батл или лёгкий соревновательный формат.
        strong НДС 22% не включён

    .games-block__grid
      article.games-card.games-card--melody
        .games-card__visual(aria-hidden="true")
          span.games-card__ring
          span.games-card__disc
          span.games-card__bar.games-card__bar--one
          span.games-card__bar.games-card__bar--two
          span.games-card__bar.games-card__bar--three

        .games-card__body
          .games-card__meta
            span music battle
            span +60 минут

          h3.games-card__title Угадай мелодию

          p.games-card__price 1 800 ₽ за человека

          p.games-card__text Бросьте вызов своей команде в музыкальной викторине: знакомые треки, быстрые ответы и азартная борьба за очки.

      article.games-card.games-card--quiz
        .games-card__visual(aria-hidden="true")
          span.games-card__question ?
          span.games-card__chip.games-card__chip--one
          span.games-card__chip.games-card__chip--two
          span.games-card__chip.games-card__chip--three

        .games-card__body
          .games-card__meta
            span smart show
            span +60 минут

          h3.games-card__title Квиз

          p.games-card__price 1 800 ₽ за человека

          p.games-card__text Интеллектуальный вызов для компании: вопросы, командные обсуждения, очки и финальная гонка за победой.

    .games-block__footer
      p Казино не является азартной игрой. Во время проведения игры участники не делают денежные ставки.

      a.games-block__button(href="#prices") Вернуться к пакетам

style.
  .games-block {
    position: relative;
    overflow: hidden;
    padding: clamp(58px, 8vw, 104px) 0;
    color: #181818;
    background:
      radial-gradient(ellipse at 12% 8%, rgba(255, 248, 102, .9), transparent 24%),
      radial-gradient(ellipse at 82% 20%, rgba(118, 199, 232, .86), transparent 26%),
      radial-gradient(ellipse at 24% 90%, rgba(247, 203, 220, .92), transparent 30%),
      linear-gradient(135deg, #ff743d 0%, #ff4f8d 46%, #7bd7f2 100%);
    font-family: var(--kv-main, Manrope, Arial, sans-serif);
    isolation: isolate;
  }

  .games-block__grain {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: .24;
    background-image:
      linear-gradient(rgba(255, 255, 255, .25) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 0, 0, .16) 1px, transparent 1px),
      repeating-radial-gradient(
        circle at 50% 50%,
        rgba(24, 24, 24, .36) 0,
        rgba(24, 24, 24, .36) .7px,
        transparent .9px,
        transparent 5px
      );
    background-size: 36px 36px, 36px 36px, 5px 5px;
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  .games-block__poster-word {
    position: absolute;
    top: 14px;
    left: 3%;
    z-index: 0;
    color: rgba(255, 250, 244, .34);
    font-size: clamp(5.5rem, 16vw, 15rem);
    font-weight: 900;
    line-height: .78;
    text-transform: uppercase;
    pointer-events: none;
  }

  .games-block__side-label {
    position: absolute;
    right: 22px;
    top: 50%;
    z-index: 1;
    color: rgba(24, 24, 24, .66);
    font-size: .72rem;
    font-weight: 900;
    letter-spacing: .2em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .games-block__shape {
    position: absolute;
    z-index: 0;
    pointer-events: none;
  }

  .games-block__shape--pink {
    right: -72px;
    bottom: 58px;
    width: clamp(190px, 26vw, 340px);
    height: clamp(100px, 14vw, 180px);
    border-radius: 50%;
    background: #f7cbdc;
    transform: rotate(-24deg);
  }

  .games-block__shape--lime {
    left: 9%;
    bottom: -86px;
    width: clamp(148px, 18vw, 246px);
    height: clamp(148px, 18vw, 246px);
    border-radius: 38% 62% 56% 44%;
    background: #dcff67;
    transform: rotate(17deg);
  }

  .games-block__shape--blue {
    right: 18%;
    top: 74px;
    width: clamp(88px, 10vw, 138px);
    height: clamp(160px, 18vw, 248px);
    border-radius: 999px;
    background: #76c7e8;
    transform: rotate(31deg);
  }

  .games-block__container {
    position: relative;
    z-index: 1;
    width: min(calc(100% - 44px), 1120px);
    margin-inline: auto;
  }

  .games-block__top {
    display: grid;
    grid-template-columns: minmax(0, .34fr) minmax(0, 1fr) minmax(260px, .42fr);
    gap: 14px;
    align-items: stretch;
    margin-bottom: 16px;
  }

  .games-block__kicker,
  .games-block__note {
    background: rgba(255, 250, 244, .9);
    box-shadow: 0 24px 52px rgba(24, 24, 24, .14);
  }

  .games-block__kicker {
    display: flex;
    min-height: 188px;
    flex-direction: column;
    justify-content: space-between;
    padding: 22px;
    font-size: .74rem;
    font-weight: 900;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .games-block__kicker span {
    display: block;
    color: #ff743d;
    font-size: clamp(3.2rem, 7vw, 5.8rem);
    line-height: .82;
  }

  .games-block__title {
    margin: 0;
    padding: clamp(24px, 4vw, 44px);
    color: #fffaf4;
    background: #181818;
    font-size: clamp(3rem, 7vw, 7rem);
    font-weight: 900;
    line-height: .8;
    text-transform: uppercase;
    box-shadow: 0 28px 58px rgba(24, 24, 24, .22);
  }

  .games-block__title span {
    color: #dcff67;
  }

  .games-block__note {
    display: flex;
    min-height: 188px;
    flex-direction: column;
    justify-content: space-between;
    padding: 24px;
  }

  .games-block__note p {
    margin: 0;
    font-size: .92rem;
    font-weight: 800;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .games-block__note strong {
    display: inline-flex;
    width: fit-content;
    padding: 9px 13px;
    border: 1px solid #181818;
    border-radius: 999px;
    background: #76c7e8;
    font-size: .7rem;
    font-weight: 900;
    letter-spacing: .05em;
    text-transform: uppercase;
  }

  .games-block__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .games-card {
    position: relative;
    display: grid;
    min-height: 430px;
    overflow: hidden;
    grid-template-rows: minmax(210px, .8fr) auto;
    background: #fffaf4;
    box-shadow: 0 30px 68px rgba(24, 24, 24, .18);
    transition:
      transform .24s ease,
      box-shadow .24s ease;
  }

  .games-card:hover {
    transform: translateY(-7px) rotate(-.45deg);
    box-shadow: 0 36px 76px rgba(24, 24, 24, .24);
  }

  .games-card--quiz {
    margin-top: 46px;
  }

  .games-card__visual {
    position: relative;
    overflow: hidden;
    min-height: 230px;
    background:
      linear-gradient(90deg, rgba(255, 250, 244, .2) 1px, transparent 1px),
      linear-gradient(rgba(255, 250, 244, .2) 1px, transparent 1px),
      #181818;
    background-size: 28px 28px;
  }

  .games-card--melody .games-card__visual {
    background-color: #76c7e8;
  }

  .games-card--quiz .games-card__visual {
    background-color: #dcff67;
  }

  .games-card__ring {
    position: absolute;
    left: 50%;
    top: 50%;
    width: clamp(148px, 22vw, 250px);
    aspect-ratio: 1;
    border: clamp(26px, 4vw, 48px) solid #181818;
    border-radius: 50%;
    transform: translate(-50%, -50%) rotate(-12deg);
  }

  .games-card__disc {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 54px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #ff743d;
    transform: translate(-50%, -50%);
  }

  .games-card__bar {
    position: absolute;
    right: 12%;
    bottom: 28px;
    width: 16px;
    border-radius: 999px;
    background: #f7cbdc;
  }

  .games-card__bar--one {
    height: 68px;
  }

  .games-card__bar--two {
    right: 18%;
    height: 120px;
  }

  .games-card__bar--three {
    right: 24%;
    height: 92px;
  }

  .games-card__question {
    position: absolute;
    left: 50%;
    top: 50%;
    color: #181818;
    font-size: clamp(8rem, 18vw, 15rem);
    font-weight: 900;
    line-height: .7;
    transform: translate(-50%, -50%) rotate(7deg);
  }

  .games-card__chip {
    position: absolute;
    width: 78px;
    height: 38px;
    border: 2px solid #181818;
    border-radius: 999px;
    background: #fffaf4;
    transform: rotate(-18deg);
  }

  .games-card__chip--one {
    left: 10%;
    top: 20%;
    background: #f7cbdc;
  }

  .games-card__chip--two {
    right: 11%;
    top: 24%;
    background: #76c7e8;
    transform: rotate(16deg);
  }

  .games-card__chip--three {
    left: 18%;
    bottom: 18%;
    background: #ff743d;
    transform: rotate(9deg);
  }

  .games-card__body {
    position: relative;
    z-index: 1;
    padding: clamp(22px, 3vw, 32px);
  }

  .games-card__body::before {
    position: absolute;
    right: -52px;
    top: -44px;
    z-index: -1;
    width: 150px;
    height: 110px;
    content: "";
    border-radius: 50%;
    background: #f7cbdc;
    transform: rotate(-18deg);
  }

  .games-card--quiz .games-card__body::before {
    background: #76c7e8;
  }

  .games-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 18px;
  }

  .games-card__meta span {
    padding: 8px 11px;
    border: 1px solid #181818;
    border-radius: 999px;
    background: rgba(255, 250, 244, .76);
    font-size: .62rem;
    font-weight: 900;
    letter-spacing: .05em;
    line-height: 1;
    text-transform: uppercase;
  }

  .games-card__title {
    margin: 0 0 12px;
    color: #181818;
    font-size: clamp(2.35rem, 5vw, 4.7rem);
    font-weight: 900;
    line-height: .82;
    text-transform: uppercase;
  }

  .games-card__price {
    width: fit-content;
    margin: 0 0 18px;
    padding: 9px 13px;
    background: #181818;
    color: #fffaf4;
    font-size: .84rem;
    font-weight: 900;
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .games-card__text {
    max-width: 560px;
    margin: 0;
    color: #242424;
    font-size: .92rem;
    font-weight: 800;
    line-height: 1.46;
    text-transform: uppercase;
  }

  .games-block__footer {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 14px;
    align-items: center;
    margin-top: 18px;
    padding: 16px;
    background: rgba(255, 250, 244, .88);
    box-shadow: 0 24px 52px rgba(24, 24, 24, .14);
  }

  .games-block__footer p {
    margin: 0;
    font-size: .78rem;
    font-weight: 900;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .games-block__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 10px 18px;
    border: 1px solid #181818;
    border-radius: 999px;
    background: #181818;
    color: #fffaf4;
    font-size: .72rem;
    font-weight: 900;
    letter-spacing: .05em;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background-color .2s ease,
      color .2s ease,
      transform .2s ease;
  }

  .games-block__button:hover {
    background: #dcff67;
    color: #181818;
    transform: translateY(-2px);
  }

  @media (max-width: 991.98px) {
    .games-block__top,
    .games-block__grid,
    .games-block__footer {
      grid-template-columns: 1fr;
    }

    .games-card--quiz {
      margin-top: 0;
    }

    .games-block__side-label {
      right: 10px;
      font-size: .66rem;
    }
  }

  @media (max-width: 575.98px) {
    .games-block {
      padding: 46px 0 62px;
    }

    .games-block__container {
      width: min(calc(100% - 34px), 1120px);
    }

    .games-block__poster-word {
      font-size: 4.8rem;
    }

    .games-block__side-label {
      display: none;
    }

    .games-block__title {
      font-size: clamp(2.75rem, 15vw, 4.6rem);
    }

    .games-block__note,
    .games-block__kicker,
    .games-card__body {
      padding: 20px;
    }

    .games-card {
      min-height: auto;
    }

    .games-card__visual {
      min-height: 206px;
    }

    .games-block__button {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .games-card,
    .games-block__button {
      transition: none;
    }
  }

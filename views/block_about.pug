section.music-party-about
  span.music-party-about__decor LIVE MUSIC
  span.music-party-about__decor-vertical SING TOGETHER
  span.music-party-about__monogram MP

  .music-party-about__stamp
    span MUSIC PARTY
    span LIVE SESSION
    span MOSCOW

  .container.position-relative.py-5(
    style="max-width:1100px; z-index:1;"
  )
    .music-party-panel
      // Описание
      .music-party-description
        span.music-party-eyebrow 02 / О формате

        h2.music-party-title
          | Что такое
          br
          span Music Party?

        .music-party-text-grid
          p.music-party-text
            | Music Party — это формат мероприятия, где гости объединяются
            | в общем музыкальном настроении.

          p.music-party-text
            | Это событие, в котором рождается атмосфера живого исполнения
            | и единства. Гости становятся частью музыкального процесса
            | и поют вместе с артистами.

          p.music-party-text
            | Слова песен выводятся на экран или оформляются в стильные
            | песенники, чтобы каждый мог легко включиться в процесс —
            | без стеснения и формальностей.

          p.music-party-text.mb-0
            | Вечер, где музыка объединяет людей, создаёт ощущение единства
            | и превращает гостей в участников одного общего музыкального момента.

      // Шаги
      .music-party-steps
        span.music-party-eyebrow 03 / Как проходит вечер

        h2.music-party-steps-title 4 простых шага

        .music-party-steps-grid
          .music-party-step
            span.music-party-step-number 01
            h3 Выбираем формат
            p Подбираем программу и музыкальное настроение.

          .music-party-step
            span.music-party-step-number 02
            h3 Добавляем опции
            p Выбираем артистов, ведущего и оборудование.

          .music-party-step
            span.music-party-step-number 03
            h3 Выбираем площадку
            p Подбираем уютный лофт или музыкальную студию.

          .music-party-step
            span.music-party-step-number 04
            h3 Поём вместе
            p Создаём один общий живой музыкальный момент.

style.
  .music-party-about {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(
        circle at 85% 20%,
        rgba(141, 66, 72, .14),
        transparent 32%
      ),
      linear-gradient(
        135deg,
        #f1e8dc 0%,
        #eadfce 55%,
        #ddc8b3 100%
      );
    font-family: Georgia, "Times New Roman", serif;
  }

  .music-party-about__decor {
    position: absolute;
    top: 18px;
    left: 4%;
    color: rgba(111, 55, 52, .07);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(5rem, 13vw, 12rem);
    font-style: italic;
    line-height: 1;
    white-space: nowrap;
    pointer-events: none;
  }

  .music-party-about__decor-vertical {
    position: absolute;
    top: 120px;
    right: 22px;
    color: rgba(111, 55, 52, .12);
    font-family: Arial, sans-serif;
    font-size: .9rem;
    font-weight: 700;
    letter-spacing: .35em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    pointer-events: none;
  }

  .music-party-about__monogram {
    position: absolute;
    right: 9%;
    bottom: 32px;
    color: rgba(111, 55, 52, .08);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(4rem, 9vw, 8rem);
    font-style: italic;
    line-height: 1;
    pointer-events: none;
  }

  .music-party-about__stamp {
    position: absolute;
    top: 90px;
    right: 9%;
    width: 130px;
    height: 130px;
    border: 1px solid rgba(111, 55, 52, .18);
    border-radius: 50%;
    color: rgba(111, 55, 52, .22);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    font-family: Arial, sans-serif;
    text-align: center;
    text-transform: uppercase;
    line-height: 1.2;
    letter-spacing: .12em;
    pointer-events: none;
  }

  .music-party-about__stamp span:nth-child(1) {
    font-size: .72rem;
    font-weight: 700;
  }

  .music-party-about__stamp span:nth-child(2) {
    margin-top: 4px;
    font-size: .6rem;
  }

  .music-party-about__stamp span:nth-child(3) {
    margin-top: 8px;
    font-size: .58rem;
  }

  .music-party-panel {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(141, 66, 72, .18);
    border-radius: 12px;
    background: #f4d0d9;
    box-shadow:
      0 26px 50px rgba(92, 53, 58, .18),
      inset 0 1px 0 rgba(255, 255, 255, .48);
  }

  .music-party-panel::before {
    display: none;
  }

  .music-party-panel::after {
    content: "";
    position: absolute;
    z-index: 1;
    inset: 14px;
    border: 1px solid rgba(141, 66, 72, .16);
    border-radius: 8px;
    pointer-events: none;
  }

  .music-party-description {
    position: relative;
    z-index: 2;
    padding: 42px 46px 34px;
  }

  .music-party-eyebrow {
    display: block;
    margin-bottom: 12px;
    color: #8d4248;
    font-size: .72rem;
    font-style: italic;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  .music-party-title {
    max-width: 620px;
    margin-bottom: 25px;
    color: #2d150f;
    font-size: clamp(2.5rem, 5vw, 4.2rem);
    font-weight: 400;
    line-height: .95;
  }

  .music-party-title span {
    color: #8d4248;
    font-style: italic;
  }

  .music-party-text {
    margin: 0;
    color: #4a2b22;
    font-family: Arial, sans-serif;
    font-size: .95rem;
    line-height: 1.65;
  }

  .music-party-text-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 13px 28px;
    max-width: 900px;
  }

  .music-party-steps {
    position: relative;
    z-index: 2;
    padding: 30px 46px 42px;
    border-top: 1px solid rgba(141, 66, 72, .16);
    background: rgba(255, 255, 255, .18);
  }

  .music-party-steps-title {
    margin-bottom: 20px;
    color: #2d150f;
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    font-weight: 400;
  }

  .music-party-steps-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
  }

  .music-party-step {
    transition: transform .25s ease;
  }

  .music-party-step:hover {
    transform: translateY(-6px);
  }

  .music-party-step {
    min-height: 138px;
    padding: 16px;
    border: 1px solid rgba(141, 66, 72, .16);
    border-radius: 4px 7px 5px 6px;
    background: rgba(255, 248, 252, .42);
    transition: border-color .25s ease, background .25s ease, box-shadow .25s ease;
  }

  .music-party-step:hover {
    border-color: rgba(141, 66, 72, .32);
    background: rgba(255, 248, 252, .66);
    box-shadow: 0 12px 26px rgba(92, 53, 58, .14);
  }

  .music-party-step-number {
    display: block;
    margin-bottom: 8px;
    color: #8d4248;
    font-size: 1.45rem;
    font-style: italic;
  }

  .music-party-step h3 {
    margin-bottom: 7px;
    color: #2d150f;
    font-family: Arial, sans-serif;
    font-size: .9rem;
    font-weight: 700;
  }

  .music-party-step p {
    margin: 0;
    color: #5a3a32;
    font-family: Arial, sans-serif;
    font-size: .76rem;
    line-height: 1.45;
  }

  @media (max-width: 991.98px) {
    .music-party-description,
    .music-party-steps {
      padding: 28px;
    }

    .music-party-text-grid,
    .music-party-steps-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .music-party-about__decor {
      top: 24px;
      left: 2%;
      font-size: 7rem;
    }

    .music-party-about__decor-vertical {
      right: 10px;
      font-size: .7rem;
      letter-spacing: .25em;
    }

    .music-party-about__stamp {
      top: 70px;
      right: 4%;
      width: 100px;
      height: 100px;
    }

    .music-party-about__monogram {
      right: 5%;
      bottom: 20px;
      font-size: 5rem;
    }
  }

  @media (max-width: 575.98px) {
    .music-party-panel {
      border-radius: 8px;
    }

    .music-party-panel::before {
      top: -30px;
      width: 68%;
      height: 46px;
    }

    .music-party-panel::after {
      inset: 10px;
    }

    .music-party-description,
    .music-party-steps {
      padding: 22px;
    }

    .music-party-text-grid,
    .music-party-steps-grid {
      grid-template-columns: 1fr;
    }

    .music-party-title {
      font-size: 2.6rem;
    }

    .music-party-step {
      min-height: 135px;
      padding: 13px;
    }

    .music-party-about__decor {
      top: 20px;
      font-size: 4.3rem;
    }

    .music-party-about__decor-vertical {
      display: none;
    }

    .music-party-about__stamp {
      top: 58px;
      right: 12px;
      width: 82px;
      height: 82px;
    }

    .music-party-about__stamp span:nth-child(1) {
      font-size: .52rem;
    }

    .music-party-about__stamp span:nth-child(2),
    .music-party-about__stamp span:nth-child(3) {
      font-size: .45rem;
    }

    .music-party-about__monogram {
      right: 12px;
      bottom: 12px;
      font-size: 3.6rem;
    }
  }

style.
  .music-party-about {
    position: relative;
    overflow: hidden;
    padding: clamp(54px, 8vw, 98px) 0;
    color: #181818;
    background:
      radial-gradient(ellipse at 18% 18%, rgba(247, 203, 220, .5), transparent 28%),
      radial-gradient(ellipse at 92% 84%, rgba(237, 104, 58, .26), transparent 30%),
      linear-gradient(135deg, #d4d2cd 0%, #b7b8b4 48%, #cbc9c4 100%);
    font-family: var(--kv-main, Manrope, Arial, sans-serif);
    isolation: isolate;
  }

  .music-party-about__grain {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: .34;
    background-image:
      linear-gradient(rgba(255, 255, 255, .2) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 0, 0, .08) 1px, transparent 1px),
      repeating-radial-gradient(
        circle at 20% 26%,
        rgba(15, 15, 15, .32) 0,
        rgba(15, 15, 15, .32) .7px,
        transparent .8px,
        transparent 4px
      );
    background-size: 34px 34px, 34px 34px, 4px 4px;
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  .music-party-about__decor {
    position: absolute;
    top: 20px;
    left: 3%;
    z-index: 0;
    color: rgba(247, 203, 220, .72);
    font-size: clamp(4.4rem, 12vw, 11rem);
    font-weight: 900;
    line-height: .9;
    text-transform: uppercase;
    white-space: nowrap;
    pointer-events: none;
  }

  .music-party-about__decor-vertical {
    position: absolute;
    right: 22px;
    top: 112px;
    z-index: 1;
    color: rgba(24, 24, 24, .58);
    font-size: .76rem;
    font-weight: 900;
    letter-spacing: .2em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    pointer-events: none;
  }

  .music-party-about__shape {
    position: absolute;
    z-index: 0;
    border-radius: 50%;
    pointer-events: none;
  }

  .music-party-about__shape--pink {
    right: min(6vw, 72px);
    bottom: 74px;
    width: clamp(120px, 20vw, 240px);
    height: clamp(260px, 34vw, 430px);
    background: #f7cbdc;
    transform: rotate(18deg);
  }

  .music-party-about__shape--orange {
    left: -72px;
    top: 40%;
    width: clamp(150px, 22vw, 280px);
    height: clamp(72px, 10vw, 122px);
    background: #ed683a;
    transform: rotate(-22deg);
  }

  .music-party-about__container {
    position: relative;
    z-index: 1;
    display: grid;
    width: min(calc(100% - 44px), 1120px);
    margin-inline: auto;
    grid-template-columns: minmax(210px, .35fr) minmax(0, 1fr);
    gap: 16px;
  }

  .music-party-about__mast {
    position: relative;
    display: flex;
    min-height: 460px;
    overflow: hidden;
    flex-direction: column;
    justify-content: space-between;
    padding: 24px;
    color: #fffaf4;
    background: #ed683a;
    box-shadow: 0 26px 58px rgba(24, 24, 24, .16);
  }

  .music-party-about__mast::after {
    position: absolute;
    right: -58px;
    bottom: -58px;
    width: 180px;
    height: 180px;
    content: "";
    border-radius: 48% 52% 44% 56%;
    background: rgba(247, 203, 220, .78);
    transform: rotate(18deg);
  }

  .music-party-about__mast-number {
    font-size: clamp(3.8rem, 8vw, 7.2rem);
    font-weight: 900;
    line-height: .78;
  }

  .music-party-about__mast-text {
    position: relative;
    z-index: 1;
    font-size: clamp(2.1rem, 4vw, 4rem);
    font-weight: 900;
    line-height: .82;
    text-transform: uppercase;
  }

  .music-party-about__mast-note {
    position: relative;
    z-index: 1;
    width: max-content;
    max-width: 100%;
    padding: 8px 14px;
    border: 1px solid #fffaf4;
    border-radius: 999px;
    font-size: .72rem;
    font-weight: 900;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .music-party-about__content {
    display: grid;
    min-height: 460px;
    align-content: space-between;
    padding: clamp(28px, 5vw, 54px);
    background:
      radial-gradient(ellipse at 94% 16%, rgba(247, 203, 220, .74), transparent 24%),
      linear-gradient(180deg, rgba(255, 250, 244, .94), rgba(255, 250, 244, .84));
    box-shadow: 0 26px 58px rgba(24, 24, 24, .14);
  }

  .music-party-about__intro {
    max-width: 720px;
  }

  .music-party-eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 13px;
    color: #181818;
    font-size: .7rem;
    font-weight: 900;
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .music-party-eyebrow::before {
    width: 40px;
    height: 6px;
    border-radius: 999px;
    content: "";
    background: #ed683a;
  }

  .music-party-title {
    max-width: 650px;
    margin: 0 0 18px;
    color: #181818;
    font-size: clamp(2.7rem, 6vw, 5.8rem);
    font-weight: 900;
    line-height: .82;
    text-transform: uppercase;
  }

  .music-party-title span {
    color: #f7cbdc;
    text-shadow: 0 2px 0 rgba(237, 104, 58, .22);
  }

  .music-party-lead {
    max-width: 620px;
    margin: 0;
    color: #181818;
    font-size: clamp(1rem, 1.5vw, 1.18rem);
    font-weight: 900;
    line-height: 1.34;
    text-transform: uppercase;
  }

  .music-party-text-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin-top: 34px;
  }

  .music-party-text {
    min-height: 112px;
    margin: 0;
    padding: 16px;
    border-left: 6px solid #f7cbdc;
    background: rgba(255, 250, 244, .62);
    color: #242424;
    font-size: .8rem;
    font-weight: 800;
    line-height: 1.42;
    text-transform: uppercase;
  }

  .music-party-text:nth-child(even) {
    border-left-color: #ed683a;
    transform: translateY(18px);
  }

  .music-party-steps {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(210px, .35fr) minmax(0, 1fr);
    gap: 16px;
    margin-top: 16px;
  }

  .music-party-steps__head {
    padding: 24px;
    background: #181818;
    color: #fffaf4;
  }

  .music-party-steps__head .music-party-eyebrow {
    color: #fffaf4;
  }

  .music-party-steps-title {
    margin: 22px 0 0;
    color: #fffaf4;
    font-size: clamp(1.7rem, 3.4vw, 3.2rem);
    font-weight: 900;
    line-height: .88;
    text-transform: uppercase;
  }

  .music-party-steps-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
  }

  .music-party-step {
    position: relative;
    min-height: 174px;
    padding: 18px;
    overflow: hidden;
    background: #fffaf4;
    box-shadow: 0 18px 38px rgba(24, 24, 24, .12);
    transition:
      transform .22s ease,
      box-shadow .22s ease;
  }

  .music-party-step:nth-child(2),
  .music-party-step:nth-child(4) {
    margin-top: 28px;
  }

  .music-party-step::after {
    position: absolute;
    right: -38px;
    bottom: -34px;
    width: 94px;
    height: 94px;
    content: "";
    border-radius: 50%;
    background: #f7cbdc;
  }

  .music-party-step:nth-child(3)::after {
    background: #ed683a;
  }

  .music-party-step:hover {
    transform: translateY(-7px) rotate(-.45deg);
    box-shadow: 0 26px 48px rgba(24, 24, 24, .18);
  }

  .music-party-step-number {
    display: block;
    margin-bottom: 16px;
    color: #ed683a;
    font-size: 2rem;
    font-weight: 900;
    line-height: .9;
  }

  .music-party-step h3 {
    position: relative;
    z-index: 1;
    margin: 0 0 8px;
    color: #181818;
    font-size: .92rem;
    font-weight: 900;
    line-height: 1.06;
    text-transform: uppercase;
  }

  .music-party-step p {
    position: relative;
    z-index: 1;
    margin: 0;
    color: #242424;
    font-size: .74rem;
    font-weight: 800;
    line-height: 1.38;
    text-transform: uppercase;
  }

  @media (max-width: 991.98px) {
    .music-party-about__container,
    .music-party-steps {
      grid-template-columns: 1fr;
    }

    .music-party-about__mast {
      min-height: 250px;
    }

    .music-party-about__content {
      min-height: auto;
    }

    .music-party-steps-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .music-party-step:nth-child(2),
    .music-party-step:nth-child(4) {
      margin-top: 0;
    }

    .music-party-about__decor-vertical {
      right: 10px;
      font-size: .68rem;
      letter-spacing: .16em;
    }
  }

  @media (max-width: 575.98px) {
    .music-party-about {
      padding: 42px 0 56px;
    }

    .music-party-about__container {
      width: min(calc(100% - 34px), 1120px);
      gap: 12px;
    }

    .music-party-about__decor {
      top: 18px;
      font-size: 4.3rem;
    }

    .music-party-about__decor-vertical {
      display: none;
    }

    .music-party-about__mast,
    .music-party-about__content,
    .music-party-steps__head {
      padding: 20px;
    }

    .music-party-about__mast {
      min-height: 220px;
    }

    .music-party-title {
      font-size: clamp(2.65rem, 14vw, 4rem);
    }

    .music-party-text-grid,
    .music-party-steps-grid {
      grid-template-columns: 1fr;
    }

    .music-party-text:nth-child(even) {
      transform: none;
    }

    .music-party-step {
      min-height: 152px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .music-party-step {
      transition: none;
    }
  }
